VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
BASE_URL=https://xencheats.wtf
CANONICAL_URL=https://xencheats.wtf
# Public URL used by Discord OAuth and the pinned verification button.
PUBLIC_SITE_URL=https://xencheats.wtf
# Hosts that should permanently redirect to CANONICAL_URL.
REDIRECT_TO_CANONICAL_HOSTS=xencheats.com,www.xencheats.com,www.xencheats.wtf

# Two-way live support: parent channel where site tickets open a Discord thread.
# Required for staff to answer tickets from Discord. Leave blank to disable.
DISCORD_SUPPORT_CHANNEL_ID=
# Role granted to repeat buyers (2+ fulfilled orders). Has a built-in default.
DISCORD_REPEAT_BUYER_ROLE_ID=

# Promo codes (optional). Comma-separated CODE:percent pairs. Leave unset to
# disable all promos. Set the real value in Render, never commit real codes.
# Example: PROMO_CODES=HALO10:10,R6SAVE:15
PROMO_CODES=

# Refuse supplier purchases that would leave less than this margin after
# payment processing. Defaults to 25 cents if unset.
SUPPLIER_MIN_MARGIN_CENTS=25

# Groq model for the Discord AI bot and search. Optional — defaults to
# openai/gpt-oss-20b. Only set this to override the default.
GROQ_MODEL=
# Enable Discord AI support. Set either flag to false to route support directly
# to staff during an incident; /togglebot and per-channel mutes still apply.
DISCORD_AI_RUNTIME_ENABLED=true
DISCORD_AI_SUPPORT_ENABLED=true
# Re-enables the pending-ticket bot after the previous global shutdown left a
# persisted false flag. The /ticketbot command still controls the live process.
DISCORD_TICKET_BOT_REENABLE_ON_BOOT=true

