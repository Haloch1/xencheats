# Discord bot (leave DISCORD_BOT_TOKEN blank to run the site without the bot)
DISCORD_BOT_TOKEN=your_discord_bot_token
# Public HTTPS video URL automatically attached by /nfa. A Discord CDN URL works.
NFA_SETUP_VIDEO_URL=
NFA_SETUP_VIDEO_NAME=nfa-setup.mp4
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
# Random 32+ byte secret for encrypted Discord OAuth refresh-token storage.
# When omitted, DISCORD_CLIENT_SECRET is used as the server-only key source.
DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY=
DISCORD_GUILD_ID=your_discord_server_id
# Optional Supabase auth user UUID for the website owner. If omitted, the
# linked Discord owner ID / owner role is used for destructive admin actions.
OWNER_USER_ID=
# Optional owner DM recipient for exact media key claim notifications and the
# private key/order operations report. Defaults to the Discord owner ID.
DISCORD_MEDIA_KEY_LOG_RECIPIENT_ID=
MEDIA_KEY_REPORT_LIMIT=100
# Private channel for exact delivered-key entries and suspicious-order alerts.
# Defaults to channel 1542361007899418714.
DISCORD_KEY_AUDIT_CHANNEL_ID=1542361007899418714
# Optional: use a permanent Discord invite instead of the direct server link
# after a member completes verification.
DISCORD_INVITE_URL=
DISCORD_CUSTOMER_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_EMPLOYEE_ROLE_ID=
DISCORD_OWNER_ROLE_ID=
DISCORD_REPEAT_BUYER_ROLE_ID=
DISCORD_RESTOCK_CHANNEL_ID=
DISCORD_LOW_STOCK_CHANNEL_ID=
DISCORD_REVIEW_CHANNEL_ID=
# Unicode emoji, custom emoji ID, or <:name:id>. Invalid :name: text falls
# back to a normal heart. Example: <:xenheart:123456789012345678>
DISCORD_VOUCH_REACTION=1539399014166962207
DISCORD_VERIFIED_ROLE_ID=
DISCORD_UNVERIFIED_ROLE_ID=
DISCORD_VERIFICATION_CHANNEL_ID=
DISCORD_VERIFICATION_ENABLED=true
DISCORD_VERIFICATION_APPEAL_CHANNEL_ID=
# Verification fraud controls. Generate a random 32+ byte value for the hash
# secret. Run supabase-discord-verification-security.sql before setting REQUIRE
# SECURITY TABLES to true. Policies: allow, review, or block.
DISCORD_VERIFICATION_IP_HASH_SECRET=
DISCORD_VERIFICATION_REQUIRE_SECURITY_TABLES=false
DISCORD_VERIFICATION_IP_REUSE_POLICY=review
DISCORD_VERIFICATION_PROXY_POLICY=review
DISCORD_VERIFICATION_SUBNET_POLICY=review
DISCORD_VERIFICATION_FRAUD_SCORE_THRESHOLD=85
# Optional IPQualityScore API key for VPN/proxy detection.
IPQUALITYSCORE_API_KEY=
TRUST_CLOUDFLARE_IP=false
# Comma-separated category IDs visible to verified members.
DISCORD_MEMBER_CATEGORY_IDS=
DISCORD_PROOF_CHANNEL_ID=
DISCORD_SUPPORT_CHANNEL_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_PENDING_TICKET_CATEGORY_ID=1529891065794924564
DISCORD_INACTIVE_TICKET_CATEGORY_ID=
DISCORD_TICKET_QUEUE_CHANNEL_ID=
# Ticket automation defaults: archive after 24h and notify staff after 20m.
DISCORD_TICKET_IDLE_HOURS=24
DISCORD_TICKET_REPLY_WAIT_MINUTES=20
DISCORD_TICKET_AUTO_DELETE_DAYS=2
DISCORD_TICKET_QUEUE_ALERT_COOLDOWN_HOURS=12
DISCORD_TICKET_CREATE_COOLDOWN_SECONDS=60
DISCORD_MAX_OPEN_TICKETS_PER_USER=1
DISCORD_TICKET_AI_MAX_REPLIES=3
DISCORD_AI_COOLDOWN_SECONDS=20
DISCORD_AI_DAILY_LIMIT=20
DISCORD_PAYMENTS_CHANNEL_ID=
DISCORD_LEAVES_CHANNEL_ID=
DISCORD_QUESTIONS_CHANNEL_ID=1528634344174780590
DISCORD_SIGNUP_CHANNEL_ID=
DISCORD_MODERATION_CHANNEL_ID=
DISCORD_TRANSCRIPT_CHANNEL_ID=
DISCORD_STAFF_GUIDE_CHANNEL_ID=
DISCORD_STATUS_SOURCE_CHANNEL_ID=
DISCORD_STATUS_TARGET_CHANNEL_ID=

# Staff anti-nuke protection. The defaults tolerate normal one-off moderation,
# but quarantine destructive bursts and mixed high-risk actions.
DISCORD_STAFF_ACTION_PROTECTION_ENABLED=true
DISCORD_STAFF_ACTION_WINDOW_SECONDS=60
DISCORD_STAFF_BAN_LIMIT=3
DISCORD_STAFF_KICK_LIMIT=4
DISCORD_STAFF_TIMEOUT_LIMIT=5
DISCORD_STAFF_CHANNEL_DELETE_LIMIT=2
DISCORD_STAFF_ROLE_DELETE_LIMIT=2
DISCORD_STAFF_WEBHOOK_LIMIT=2
DISCORD_STAFF_OVERWRITE_DELETE_LIMIT=4
DISCORD_STAFF_BOT_ADD_LIMIT=2
DISCORD_STAFF_DANGEROUS_GRANT_LIMIT=2
DISCORD_STAFF_RISK_THRESHOLD=10
DISCORD_STAFF_QUARANTINE_MINUTES=60
DISCORD_STAFF_ALERT_COOLDOWN_SECONDS=60
DISCORD_STAFF_KICK_ON_CONTAINMENT=true
DISCORD_STAFF_ADVANCED_PATTERNS_ENABLED=true
DISCORD_STAFF_FAST_BURST_SECONDS=10

# Google OAuth sign-in (optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Apple Sign in. Create these in Apple Developer before enabling the button.
APPLE_CLIENT_ID=your_apple_services_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----"

# Error monitoring posts deduplicated production failures to this Discord channel.
DISCORD_ERROR_CHANNEL_ID=1530317219337076837

# Admin two-factor authentication. Keep disabled until the SQL migration is run
# and every admin has enrolled a TOTP app. The encryption key must be 32+ random bytes.
ADMIN_TOTP_REQUIRED=false
ADMIN_TOTP_ENCRYPTION_KEY=

# Database backup script. SUPABASE_DB_URL is the direct Postgres connection string,
# never the public Supabase project URL. Backups must be copied to offsite storage.
SUPABASE_DB_URL=
BACKUP_DIR=./backups

# Crypto payments via NOWPayments (optional)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_KEY=your_nowpayments_ipn_secret

# Groq API key for AI search / support answers (optional)
GROQ_API_KEY=your_groq_api_key

# Gemini powers Discord ticket summaries and queue alerts (optional)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
# Optional: post only flagged AI-answer reviews to this private Discord channel.
# Defaults to DISCORD_ERROR_CHANNEL_ID; Flash keeps this second-pass check inexpensive.
AI_QUALITY_ALERT_CHANNEL_ID=
AI_QUALITY_MODEL=gemini-3.5-flash

# Cheats.Love live catalog and buy-on-demand API
# Requests are hard-limited in code to 15/minute (provider limit: 30/minute).
# Do not add a configurable override or bypass the shared request queue.
CHEATSLOVE_API_KEY=rk_replace_me
CHEATSLOVE_BASE_URL=https://res.cheatslove.com/api/v1

# RFT native Seller API. This is intentionally separate from any SellAuth key
# used by another supplier such as Ghostware. The legacy variable remains a
# server-side fallback for existing deployments.
RFT_SELLER_API_KEY=
RFT_API_BASE_URL=https://api.reselling.pro/rft
RFT_SELLAUTH_RESELLER_API_KEY=
RFT_SELLAUTH_RESELLER_BASE_URL=https://api.reselling.pro/rft
RFT_SELLAUTH_CATALOG_MINUTES=30
RFT_EXACT_STOCK_MINUTES=5
RFT_STOCK_COUNT_CEILING=100

# Transactional email via Resend (optional)
RESEND_API_KEY=your_resend_api_key

# Social posting for /upload (all optional)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_bluesky_app_password
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret

# Emergency kill switch: set to "true" to block all checkouts
PURCHASES_DISABLED=
