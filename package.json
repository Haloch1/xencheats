{
  "name": "halo-cheats-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server.js",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build && npx playwright install chromium",
    "discord:check": "node scripts/check-discord-config.mjs",
    "discord:check:static": "node scripts/check-discord-config.mjs --static",
    "support:eval": "node scripts/support-evals.mjs",
    "groq:resilience:test": "node scripts/groq-resilience.test.mjs",
    "finance:test": "node scripts/finance-engine.test.mjs",
    "finance:workflow:simulate": "node scripts/cheatslove-workflow-simulate.mjs",
    "finance:workflow:test": "node scripts/cheatslove-workflow.test.mjs",
    "finance:coinbase:test": "node scripts/coinbase-integration.test.mjs",
    "finance:coinbase:browser:test": "node scripts/coinbase-browser-operator.test.mjs",
    "finance:bridge:test": "node scripts/reinvestment-bridge.test.mjs",
    "loyalty:test": "node scripts/customer-loyalty.test.mjs",
    "buynfa:test": "node scripts/buynfa-reseller.test.mjs",
    "guest-checkout:test": "node scripts/guest-checkout-token.test.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "stripe:setup": "node scripts/setup-stripe-catalog.mjs",
    "start": "node server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "node-fetch": "^3.3.2",
    "oauth-1.0a": "^2.2.6",
    "playwright": "^1.61.1",
    "sharp": "^0.35.4",
    "stripe": "^18.5.0",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
